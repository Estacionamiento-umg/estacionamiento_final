import tkinter as tk
from tkinter import messagebox, simpledialog

import archivos
from usuarios_vehiculos import registrar_usuario, registrar_vehiculo
from espacios import listar_espacios
from reservas import crear_reserva
from ingresos import registrar_ingreso
from salidas_pagos import registrar_salida
from reportes import reporte_por_fecha, vehiculos_dentro


archivos.inicializar_datos()


def usuario():
    nombre = simpledialog.askstring("Usuario", "Nombre:")
    telefono = simpledialog.askstring("Usuario", "Teléfono:")

    if nombre and telefono:
        try:
            resultado = registrar_usuario(nombre, telefono)
            messagebox.showinfo(
                "Correcto",
                "Usuario registrado\nID: " + resultado["id_usuario"]
            )
        except ValueError as error:
            messagebox.showerror("Error", str(error))


def vehiculo():
    id_usuario = simpledialog.askstring("Vehículo", "ID del usuario:")
    placa = simpledialog.askstring("Vehículo", "Placa:")
    tipo = simpledialog.askstring(
        "Vehículo",
        "Tipo: carro, moto, camion u otro:"
    )

    if id_usuario and placa and tipo:
        try:
            registrar_vehiculo(id_usuario, placa, tipo)
            messagebox.showinfo("Correcto", "Vehículo registrado")
        except ValueError as error:
            messagebox.showerror("Error", str(error))


def espacios():
    lista = listar_espacios()

    texto = ""

    for espacio in lista:
        texto += (
            espacio["codigo"]
            + " - "
            + espacio["tipo"]
            + " - "
            + espacio["estado"]
            + "\n"
        )

    messagebox.showinfo("Espacios", texto)


def reserva():
    id_usuario = simpledialog.askstring("Reserva", "ID usuario:")
    placa = simpledialog.askstring("Reserva", "Placa:")
    espacio = simpledialog.askstring("Reserva", "Código del espacio:")
    inicio = simpledialog.askstring(
        "Reserva",
        "Inicio: AAAA-MM-DD HH:MM"
    )
    fin = simpledialog.askstring(
        "Reserva",
        "Fin: AAAA-MM-DD HH:MM"
    )

    try:
        resultado = crear_reserva(
            id_usuario,
            placa,
            espacio,
            inicio,
            fin
        )

        messagebox.showinfo(
            "Correcto",
            "Reserva creada\nID: " + resultado["id_reserva"]
        )

    except ValueError as error:
        messagebox.showerror("Error", str(error))


def ingreso():
    placa = simpledialog.askstring("Ingreso", "Placa:")

    try:
        resultado = registrar_ingreso(placa)

        messagebox.showinfo(
            "Ingreso registrado",
            "Espacio asignado: " + resultado["espacio"]
        )

    except ValueError as error:
        messagebox.showerror("Error", str(error))


def salida():
    placa = simpledialog.askstring("Salida", "Placa:")

    try:
        resultado = registrar_salida(placa)

        messagebox.showinfo(
            "Salida registrada",
            "Total a pagar: Q" + str(resultado["total"])
        )

    except ValueError as error:
        messagebox.showerror("Error", str(error))


def reporte():
    fecha = simpledialog.askstring(
        "Reporte",
        "Fecha: AAAA-MM-DD"
    )

    resultado = reporte_por_fecha(fecha)

    texto = (
        "Fecha: " + resultado["fecha"]
        + "\nEntradas: " + str(resultado["cantidad_entradas"])
        + "\nPagos: " + str(resultado["cantidad_pagos"])
        + "\nIngresos: Q" + str(resultado["ingresos"])
    )

    messagebox.showinfo("Reporte", texto)


def dentro():
    lista = vehiculos_dentro()

    if len(lista) == 0:
        messagebox.showinfo(
            "Vehículos dentro",
            "No hay vehículos dentro."
        )
        return

    texto = ""

    for movimiento in lista:
        texto += (
            movimiento["placa"]
            + " - Espacio "
            + movimiento["espacio"]
            + "\n"
        )

    messagebox.showinfo("Vehículos dentro", texto)


ventana = tk.Tk()
ventana.title("Sistema de Estacionamiento")
ventana.geometry("500x550")
ventana.resizable(False, False)


titulo = tk.Label(
    ventana,
    text="SISTEMA DE ESTACIONAMIENTO",
    font=("Arial", 18, "bold")
)

titulo.pack(pady=25)


tk.Button(
    ventana,
    text="Registrar usuario",
    width=30,
    command=usuario
).pack(pady=6)


tk.Button(
    ventana,
    text="Registrar vehículo",
    width=30,
    command=vehiculo
).pack(pady=6)


tk.Button(
    ventana,
    text="Ver espacios",
    width=30,
    command=espacios
).pack(pady=6)


tk.Button(
    ventana,
    text="Crear reserva",
    width=30,
    command=reserva
).pack(pady=6)


tk.Button(
    ventana,
    text="Registrar ingreso",
    width=30,
    command=ingreso
).pack(pady=6)


tk.Button(
    ventana,
    text="Registrar salida y pago",
    width=30,
    command=salida
).pack(pady=6)


tk.Button(
    ventana,
    text="Reporte por fecha",
    width=30,
    command=reporte
).pack(pady=6)


tk.Button(
    ventana,
    text="Vehículos dentro",
    width=30,
    command=dentro
).pack(pady=6)


tk.Button(
    ventana,
    text="Salir",
    width=30,
    command=ventana.destroy
).pack(pady=20)


ventana.mainloop()